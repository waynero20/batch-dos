# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/
build/
next-env.d.ts

# production
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — service account credentials must never be committed
.env
.env*.local
.env.production

# Google Cloud service-account keys.
# Google names downloaded keys <project>-<hash>.json, which no generic pattern
# catches, so deny every root-level .json and re-allow the ones the app needs.
/*.json
!/package.json
!/tsconfig.json
!/components.json
!/vercel.json

# vercel
.vercel

# typescript
*.tsbuildinfo
