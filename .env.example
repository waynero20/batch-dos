# Copy to .env.local and fill in. Never commit the filled-in file.

# From the service-account JSON you downloaded from Google Cloud.
# GOOGLE_PRIVATE_KEY keeps its literal \n escapes — paste it exactly as it appears
# in the JSON, wrapped in double quotes. Do not hand-edit the newlines.
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# The reunion workbook. Share it with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
SHEET_ID=

# The committee tally lives at /results/<RESULTS_SECRET>. Unset means the page 404s.
RESULTS_SECRET=

# Set to false to make the ballot read-only.
VOTING_OPEN=true

# Public origin of the deployment. Without it the Messenger link unfurls with no
# picture, which matters because the link is shared exactly once.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
